# apps/server/.env.example — copy it to .env (gitignored) and fill it in; never commit .env
# the password every seeded user signs in with (bun run db:seed): 8 characters or more
SEED_PASSWORD=
# the database: compose's Postgres (docker compose up -d --wait); on Neon, its connection string
DATABASE_URL=postgres://office:office@localhost:5432/office
# Better Auth signs the session cookie with it: 32 characters or more, made with
# bun -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# where the API runs: Better Auth writes its links (verify, reset) from it
BETTER_AUTH_URL=http://localhost:3000