# apps/server/.env.test — bun test reads it over .env: the tests' own database, never the app's
# committed: nothing secret here; on Neon, put your own line in .env.test.local (gitignored)
DATABASE_URL=postgres://office:office@localhost:5432/office_test
# made up for the tests only: never use these values in .env
BETTER_AUTH_SECRET=test-only-secret-not-for-the-app-0123456789
BETTER_AUTH_URL=http://localhost:3000
# empty: the tests' mails are printed, never sent
SMTP_URL=